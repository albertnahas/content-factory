{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "services/**/*",
    "pipelines/**/*",
    "ideas-bank/**/*",
    "config/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "remotion"
  ]
}
